{
  "name": "pastoral-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:homolog": "node scripts/write-runtime-config.mjs && ng build",
    "build:producao": "node scripts/write-runtime-config.mjs && ng build",
    "serve:static": "node scripts/static-server.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs --env homologacao",
    "pm2:restart": "pm2 restart pastoral-frontend",
    "pm2:stop": "pm2 stop pastoral-frontend",
    "pm2:logs": "pm2 logs pastoral-frontend"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^21.3.0",
    "@angular-eslint/eslint-plugin-template": "^21.3.0",
    "@angular-eslint/template-parser": "^21.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "angular-eslint": "^21.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
